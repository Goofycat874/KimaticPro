{
  "name": "KimaticPro — 3D CAD for everyone",
  "short_name": "KimaticPro",
  "description": "Free, open-source, beginner-friendly parametric 3D CAD. Design and export for 3D printing.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#16171b",
  "theme_color": "#1b1c21",
  "categories": ["design", "productivity", "education"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/json": [".kimatic"], "model/stl": [".stl"] } }
  ]
}
